<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="拾字 · 输入历史" Width="880" Height="590" MinWidth="660" MinHeight="440" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" ShowInTaskbar="False" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="13" Foreground="{DynamicResource ThemeText}" UseLayoutRounding="True">
 <Window.Resources>
  <SolidColorBrush x:Key="ThemeText" Color="#202333"/>
  <SolidColorBrush x:Key="ThemeMuted" Color="#9290A6"/>
  <SolidColorBrush x:Key="ThemeCardText" Color="#444057"/>
  <SolidColorBrush x:Key="ThemeSurface" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="ThemeCanvas" Color="#FBFBFE"/>
  <SolidColorBrush x:Key="ThemeBorder" Color="#E5E5EE"/>
  <SolidColorBrush x:Key="ThemeScrollTrack" Color="#F5F4FA"/>
  <SolidColorBrush x:Key="ThemeScrollThumb" Color="#C6C1D3"/>
  <SolidColorBrush x:Key="ThemeScrollHover" Color="#A69BBB"/>
  <SolidColorBrush x:Key="ThemeScrollActive" Color="#76659F"/>
  <SolidColorBrush x:Key="ThemeButton" Color="#F0F1F6"/>
  <SolidColorBrush x:Key="ThemeButtonText" Color="#53576B"/>
  <SolidColorBrush x:Key="ThemeAccentText" Color="#76659F"/>
  <SolidColorBrush x:Key="ThemeFocus" Color="#9C8CEF"/>
  <SolidColorBrush x:Key="ThemeSelection" Color="#B2A5F4"/>
  <SolidColorBrush x:Key="ThemeHover" Color="#F0EFF8"/>
  <SolidColorBrush x:Key="ThemeSelected" Color="#EFEBFC"/>
  <SolidColorBrush x:Key="ThemeSelectedBorder" Color="#DDD5F6"/>
  <SolidColorBrush x:Key="ThemeSoftAccent" Color="#F0EDFB"/>
  <SolidColorBrush x:Key="ThemePositive" Color="#EAF5EE"/>
  <SolidColorBrush x:Key="ThemePositiveText" Color="#3C8560"/>
  <SolidColorBrush x:Key="ThemePositiveBorder" Color="#D4E8DA"/>
  <SolidColorBrush x:Key="ThemeDanger" Color="#F8EBEE"/>
  <SolidColorBrush x:Key="ThemeDangerText" Color="#B46A79"/>
  <SolidColorBrush x:Key="ThemeWarning" Color="#F4EFE4"/>
  <SolidColorBrush x:Key="ThemeWarningText" Color="#9B7E49"/>
  <SolidColorBrush x:Key="Accent" Color="#6854DF"/>
  <Style TargetType="Button">
   <Setter Property="Background" Value="{DynamicResource ThemeButton}"/><Setter Property="Foreground" Value="{DynamicResource ThemeButtonText}"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.9"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Opacity" Value="0.7"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource ThemeFocus}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="HeaderIcon" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="Width" Value="30"/><Setter Property="Height" Value="30"/><Setter Property="Padding" Value="7"/><Setter Property="Margin" Value="0,0,6,0"/><Setter Property="Background" Value="{DynamicResource ThemeSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/>
   <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource ThemeSoftAccent}"/></Trigger></Style.Triggers>
  </Style>
  <Style x:Key="LanguageMenu" TargetType="ContextMenu">
   <Setter Property="Width" Value="202"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="FontSize" Value="12"/><Setter Property="HasDropShadow" Value="False"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ContextMenu"><Border Margin="6" Padding="5" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="10"><Border.Effect><DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.18" Color="#11111B"/></Border.Effect><StackPanel IsItemsHost="True" KeyboardNavigation.DirectionalNavigation="Cycle"/></Border></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="LanguageMenuItem" TargetType="MenuItem">
   <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="MenuItem"><Border x:Name="MenuRow" CornerRadius="6" Background="{TemplateBinding Background}" Padding="10,9" Margin="0,1"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="23"/></Grid.ColumnDefinitions><ContentPresenter ContentSource="Header" VerticalAlignment="Center" RecognizesAccessKey="True"/><TextBlock x:Name="Check" Grid.Column="1" Text="✓" Foreground="{DynamicResource ThemeAccentText}" HorizontalAlignment="Right" Visibility="Collapsed"/></Grid></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger><Trigger Property="IsChecked" Value="True"><Setter TargetName="Check" Property="Visibility" Value="Visible"/><Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Background" Value="{DynamicResource ThemeSurface}"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/><Setter Property="FontSize" Value="11"/><Setter Property="HasDropShadow" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="10,6"><ContentPresenter/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Padding" Value="10"/><Setter Property="BorderBrush" Value="{DynamicResource ThemeBorder}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="Background" Value="{DynamicResource ThemeSurface}"/><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="CaretBrush" Value="{DynamicResource ThemeText}"/><Setter Property="SelectionBrush" Value="{DynamicResource ThemeSelection}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/></Style>
  <Style x:Key="AppScrollBarStyle" TargetType="ScrollBar">
   <Setter Property="Width" Value="10"/><Setter Property="MinHeight" Value="0"/><Setter Property="Background" Value="{DynamicResource ThemeScrollTrack}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Border Background="{TemplateBinding Background}" CornerRadius="5"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton x:Name="Decrease" Command="ScrollBar.PageUpCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border x:Name="ScrollThumb" Background="{DynamicResource ThemeScrollThumb}" CornerRadius="3" Margin="2,2"/><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ScrollThumb" Property="Background" Value="{DynamicResource ThemeScrollHover}"/></Trigger><Trigger Property="IsDragging" Value="True"><Setter TargetName="ScrollThumb" Property="Background" Value="{DynamicResource ThemeScrollActive}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton x:Name="Increase" Command="ScrollBar.PageDownCommand" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Border><ControlTemplate.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False"/><Setter TargetName="Decrease" Property="Command" Value="ScrollBar.PageLeftCommand"/><Setter TargetName="Increase" Property="Command" Value="ScrollBar.PageRightCommand"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
   <Style.Triggers><Trigger Property="Orientation" Value="Horizontal"><Setter Property="Width" Value="Auto"/><Setter Property="Height" Value="10"/></Trigger></Style.Triggers>
  </Style>
  <Style TargetType="ScrollBar" BasedOn="{StaticResource AppScrollBarStyle}"/>
  <Style x:Key="VersionSelector" TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource ThemeAccentText}"/><Setter Property="Height" Value="31"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Foreground="{TemplateBinding Foreground}" Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource ThemeSoftAccent}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="7"><ContentPresenter/></Border></ControlTemplate></ToggleButton.Template>
     <Grid Margin="10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="20"/></Grid.ColumnDefinitions><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="⌄" FontSize="14" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    </ToggleButton>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="7" Padding="4" Margin="0,3,0,0"><ScrollViewer MaxHeight="230" CanContentScroll="True"><ItemsPresenter/></ScrollViewer></Border></Popup>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox" BasedOn="{StaticResource VersionSelector}"/>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource ThemeText}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="Transparent" CornerRadius="4" Padding="8,6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource ThemeSelected}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource ThemeText}"/><Setter Property="Margin" Value="0,8,0,8"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="13,12"/><Setter Property="Margin" Value="0,0,0,6"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="Card" Background="Transparent" CornerRadius="10" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource ThemeHover}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource ThemeSelected}"/><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource ThemeSelectedBorder}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border CornerRadius="18" Background="{DynamicResource ThemeCanvas}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" Margin="8">
  <Border.Effect><DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.13" Color="#292044"/></Border.Effect>
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="62"/><RowDefinition Height="*"/><RowDefinition Height="48"/></Grid.RowDefinitions>
   <Grid x:Name="DragArea" Margin="24,18,20,14" Background="Transparent">
    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Image x:Name="BrandImage" Width="44" Height="44" HorizontalAlignment="Left" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality"/>
    <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="拾字" FontSize="21" FontWeight="SemiBold"/><TextBlock Text="打过的字，随时找回" Foreground="{DynamicResource ThemeMuted}" FontSize="11" Margin="0,3,0,0"/></StackPanel>
    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="PauseButton" Height="30" Padding="11,5" Margin="0,0,8,0" Background="{DynamicResource ThemePositive}" Foreground="{DynamicResource ThemePositiveText}" Content="●  正在记录" ToolTip="暂停或恢复记录"/>
     <Button x:Name="ThemeButton" Style="{StaticResource HeaderIcon}" ToolTip="切换到深色模式">
      <Grid Width="14" Height="14" IsHitTestVisible="False">
       <Path x:Name="ThemeMoon" Fill="{DynamicResource ThemeAccentText}" Data="M 11,1 C 6,-1 1,2 1,7 C 1,12 7,15 11,11 C 5,12 2,5 6,2 C 7,1 9,1 11,1 Z"/>
       <Path x:Name="ThemeSun" Visibility="Collapsed" Stroke="{DynamicResource ThemeAccentText}" StrokeThickness="1.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 7,0.8 L 7,2 M 7,12 L 7,13.2 M 0.8,7 L 2,7 M 12,7 L 13.2,7 M 2.6,2.6 L 3.5,3.5 M 10.5,10.5 L 11.4,11.4 M 2.6,11.4 L 3.5,10.5 M 10.5,3.5 L 11.4,2.6 M 7,4 A 3,3 0 1 0 7,10 A 3,3 0 1 0 7,4"/>
      </Grid>
     </Button>
     <Button x:Name="LanguageButton" Style="{StaticResource HeaderIcon}" Width="38" Padding="6" ToolTip="界面语言">
      <Grid Width="22" Height="16" IsHitTestVisible="False">
       <Path Stroke="{DynamicResource ThemeAccentText}" StrokeThickness="1.2" StrokeLineJoin="Round" Data="M 8,1 A 7,7 0 1 0 8,15 A 7,7 0 1 0 8,1 M 1,8 L 15,8 M 8,1 C 4,4 4,12 8,15 M 8,1 C 12,4 12,12 8,15"/>
       <Path Stroke="{DynamicResource ThemeAccentText}" StrokeThickness="1.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 18,7 L 20,9 L 22,7"/>
      </Grid>
     </Button>
     <Button x:Name="SettingsButton" Content="设置" Background="Transparent" Padding="10,7" Margin="0,0,4,0"/>
     <Button x:Name="CloseButton" Content="×" FontSize="23" Padding="10,1" Background="Transparent" ToolTip="收起到后台 · Esc"/>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" Margin="24,0,24,16">
    <Border Background="{DynamicResource ThemeSurface}" CornerRadius="10" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1"/>
    <Grid Margin="12,0"><Grid.ColumnDefinitions><ColumnDefinition Width="28"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock Text="⌕" FontSize="25" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center"/>
     <TextBox x:Name="SearchBox" Grid.Column="1" BorderThickness="0" Background="Transparent" Padding="2,5" FontSize="13"/>
     <TextBlock x:Name="SearchHint" Grid.Column="1" Text="搜索文字或应用…" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center" IsHitTestVisible="False" Margin="2,0"/>
     <TextBlock Grid.Column="2" Text="Ctrl + F" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center" FontSize="11"/>
    </Grid>
   </Grid>
   <Grid Grid.Row="2" Margin="16,0,24,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="286"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="28"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="ListHeading" Text="最近输入" FontSize="11" Foreground="{DynamicResource ThemeMuted}" Margin="12,0"/>
     <ListBox x:Name="HistoryList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto" VirtualizingStackPanel.IsVirtualizing="True" VirtualizingStackPanel.VirtualizationMode="Recycling">
      <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Meta}" FontSize="10" Foreground="{DynamicResource ThemeMuted}" TextTrimming="CharacterEllipsis" Margin="0,0,0,7"/><Grid><TextBlock x:Name="EntryPreview" Text="{Binding Preview}" FontSize="13" Foreground="{DynamicResource ThemeCardText}" TextWrapping="Wrap" MaxHeight="43" LineHeight="21" TextTrimming="CharacterEllipsis"/><Border x:Name="ClearedMarker" Visibility="Collapsed" Background="{DynamicResource ThemeSoftAccent}" CornerRadius="5" Padding="8,4" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><TextBlock Text="⌫" Foreground="{DynamicResource ThemeAccentText}" Margin="0,0,6,0"/><TextBlock Text="{Binding Preview}" FontSize="11" Foreground="{DynamicResource ThemeAccentText}"/></StackPanel></Border></Grid></StackPanel><DataTemplate.Triggers><DataTrigger Binding="{Binding IsCleared}" Value="True"><Setter TargetName="EntryPreview" Property="Visibility" Value="Collapsed"/><Setter TargetName="ClearedMarker" Property="Visibility" Value="Visible"/></DataTrigger></DataTemplate.Triggers></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
    <Border Grid.Column="2" Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="12">
     <Grid x:Name="DetailPanel" Margin="18">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="DetailSource" FontWeight="SemiBold" FontSize="13"/><TextBlock x:Name="DetailMeta" Foreground="{DynamicResource ThemeMuted}" FontSize="10" Margin="0,5,0,0"/><ComboBox x:Name="VersionCombo" Style="{StaticResource VersionSelector}" Visibility="Collapsed" HorizontalAlignment="Left" MinWidth="190" Margin="0,10,0,0" Padding="8,4" FontSize="11" ToolTip="同一段文字的修改前内容，集中保存在这里"/></StackPanel><Button x:Name="DeleteButton" Grid.Column="1" Content="删除" Background="Transparent" Foreground="{DynamicResource ThemeMuted}" FontSize="11" Padding="6,4" VerticalAlignment="Top"/></Grid>
      <Grid Grid.Row="1">
       <TextBox x:Name="DetailText" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" BorderThickness="0" Background="Transparent" Padding="0" VerticalContentAlignment="Top" FontSize="15" Foreground="{DynamicResource ThemeText}"/>
       <StackPanel x:Name="ClearedDraftPanel" Visibility="Collapsed" IsHitTestVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="14">
        <Border Width="48" Height="48" Background="{DynamicResource ThemeSoftAccent}" CornerRadius="14" HorizontalAlignment="Center" Margin="0,0,0,14"><Path Width="24" Height="18" Stretch="Uniform" Stroke="{DynamicResource ThemeAccentText}" StrokeThickness="1.6" StrokeLineJoin="Round" Data="M 8,1 L 23,1 L 23,17 L 8,17 L 1,9 Z M 12,6 L 18,12 M 18,6 L 12,12"/></Border>
        <TextBlock Text="已清空" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource ThemeMuted}" HorizontalAlignment="Center"/>
        <TextBlock Text="文字已全部删除，可在上方查看修改前版本" Foreground="{DynamicResource ThemeMuted}" FontSize="11" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="290" Margin="0,8,0,0"/>
       </StackPanel>
      </Grid>
      <Grid Grid.Row="2" Margin="0,16,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="SelectionHint" Text="拖选文字，可只复制选中部分" Foreground="{DynamicResource ThemeMuted}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/><Button x:Name="CopySelectionButton" Grid.Column="1" Content="复制选中" Padding="10,9" Margin="0,0,7,0" IsEnabled="False"/><Button x:Name="CopyButton" Grid.Column="2" Content="复制整段" Padding="16,9" Background="{DynamicResource Accent}" Foreground="White"/></Grid>
     </Grid>
    </Border>
    <Border x:Name="EmptyPanel" Grid.ColumnSpan="3" Background="{DynamicResource ThemeCanvas}" CornerRadius="12">
     <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24">
      <Border Width="70" Height="70" CornerRadius="22" Background="{DynamicResource ThemeSoftAccent}" Margin="0,0,0,19"><TextBlock Text="“" FontFamily="Georgia" FontSize="68" Foreground="{DynamicResource ThemeAccentText}" HorizontalAlignment="Center" Margin="0,4,0,0"/></Border>
      <TextBlock x:Name="EmptyTitle" Text="下一次灵感，不用重打一遍" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center"/>
      <TextBlock x:Name="EmptyDescription" Text="去任意支持的输入框打字，历史会自动出现在这里。" Foreground="{DynamicResource ThemeMuted}" FontSize="12" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,19"/>
      <Border Background="{DynamicResource ThemeSurface}" BorderBrush="{DynamicResource ThemeBorder}" BorderThickness="1" CornerRadius="8" Padding="16,9" HorizontalAlignment="Center"><TextBlock x:Name="EmptyShortcut" Text="Alt + `    随时呼出" Foreground="{DynamicResource ThemeAccentText}" FontSize="12"/></Border>
      <TextBlock Text="本机保存  ·  自动滚动清理  ·  标准密码框不记录" Foreground="{DynamicResource ThemeMuted}" FontSize="10" HorizontalAlignment="Center" Margin="0,20,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
   <Grid Grid.Row="3" Margin="26,0,26,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="就绪" FontSize="10" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0"/><TextBlock x:Name="UsageText" Grid.Column="1" FontSize="10" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center"/></Grid>
   <Border x:Name="SettingsOverlay" Grid.RowSpan="4" Background="{DynamicResource ThemeCanvas}" CornerRadius="17" Visibility="Collapsed">
    <Grid Margin="32,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <Grid><TextBlock Text="按你的习惯拾字" FontSize="22" FontWeight="SemiBold"/><Button x:Name="SettingsCloseButton" Content="×" FontSize="23" HorizontalAlignment="Right" Background="Transparent" Padding="10,0"/></Grid>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,22,0,18">
      <StackPanel>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,28,0"><TextBlock Text="呼出快捷键" FontWeight="SemiBold" Margin="0,0,0,10"/><Button x:Name="HotkeyButton" Content="Alt + `" HorizontalAlignment="Left" Padding="24,11" Background="{DynamicResource ThemeSoftAccent}" Foreground="{DynamicResource ThemeAccentText}"/><TextBlock Text="点击后直接按新的组合键；Esc 取消。" Foreground="{DynamicResource ThemeMuted}" FontSize="11" Margin="0,8,0,0"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="最多保留字符" FontWeight="SemiBold" Margin="0,0,0,10"/><ComboBox x:Name="LimitCombo" Height="38" Padding="10,7"><ComboBoxItem Content="10,000 字符" Tag="10000"/><ComboBoxItem Content="50,000 字符" Tag="50000"/><ComboBoxItem Content="100,000 字符" Tag="100000"/><ComboBoxItem Content="500,000 字符" Tag="500000"/></ComboBox><TextBlock Text="达到上限后，自动移除最早的记录。" Foreground="{DynamicResource ThemeMuted}" FontSize="11" Margin="0,8,0,0"/></StackPanel>
       </Grid>
       <Border Height="1" Background="{DynamicResource ThemeBorder}" Margin="0,22,0,14"/>
       <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions><TextBlock Text="界面语言" FontWeight="SemiBold" VerticalAlignment="Center"/><ComboBox x:Name="LanguageCombo" Grid.Column="1" Height="34" Padding="8,4"><ComboBoxItem Content="跟随系统 / System" Tag="auto"/><ComboBoxItem Content="简体中文" Tag="zh"/><ComboBoxItem Content="English" Tag="en"/></ComboBox></Grid>
       <CheckBox x:Name="RememberCheck" Content="退出后保留历史（使用当前 Windows 账户加密）"/>
       <CheckBox x:Name="StartupCheck" Content="登录 Windows 后自动在后台运行"/>
       <TextBlock Text="不记录这些应用" FontWeight="SemiBold" Margin="0,17,0,9"/>
       <TextBox x:Name="ExcludedBox" Height="63" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
       <TextBlock Text="填写进程名，用逗号分隔，例如 WeChat, chrome。标准密码框自动跳过。" Foreground="{DynamicResource ThemeMuted}" FontSize="11" Margin="0,7,0,0" TextWrapping="Wrap"/>
       <TextBlock Text="打过的字自动保存，按快捷键随时找回。同一输入框连续记录，中英文混输合并；原有正文不会整段存入历史。" Foreground="{DynamicResource ThemeMuted}" FontSize="11" Margin="0,18,0,0" TextWrapping="Wrap"/>
      </StackPanel>
     </ScrollViewer>
     <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Button x:Name="ClearButton" Content="清空所有历史" Background="{DynamicResource ThemeDanger}" Foreground="{DynamicResource ThemeDangerText}"/><TextBlock x:Name="SettingsStatus" Grid.Column="1" Foreground="{DynamicResource ThemeMuted}" VerticalAlignment="Center" TextWrapping="Wrap" FontSize="11" Margin="16,0"/><Button x:Name="SaveSettingsButton" Grid.Column="2" Content="保存设置" Background="{DynamicResource Accent}" Foreground="White" Padding="22,10"/></Grid>
    </Grid>
